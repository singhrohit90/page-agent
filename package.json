{
  "name": "testfloor-page-agent-demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "prestart": "node scripts/preflight.mjs",
    "start": "npm run build && node server/proxy.mjs",
    "build": "ng build --configuration production",
    "serve": "node server/proxy.mjs",
    "test:unit": "node --test tests/upstream.test.mjs tests/anthropic-native.test.mjs tests/fake-anthropic.test.mjs tests/anthropic-proxy.test.mjs tests/config.test.mjs",
    "test:smoke": "playwright test -c playwright.mock.config.ts",
    "test:live": "playwright test -c playwright.live.config.ts"
  },
  "dependencies": {
    "@angular/cdk": "22.2.3",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "page-agent": "1.12.4",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@playwright/test": "1.64.1",
    "typescript": "6.0.3"
  }
}
